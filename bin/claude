#!/usr/bin/env sh
# Unofficial Claude CLI shim.  It only translates the exact --yolo argument.
set -u

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd -P)

# Rewrite the positional parameters in place: shift each argument off the
# front and append its translation, so after one full rotation "$@" is the
# translated list.  No arrays, so this runs under any POSIX sh.
remaining=$#
while [ "$remaining" -gt 0 ]; do
    argument=$1
    shift
    case "$argument" in
        --yolo) set -- "$@" --dangerously-skip-permissions ;;
        *) set -- "$@" "$argument" ;;
    esac
    remaining=$((remaining - 1))
done

# The wrapper's own directory contains nothing but the shim, so a candidate
# that resolves into it would exec this script again, forever.
points_at_self() {
    candidate_dir=$(CDPATH= cd -- "$(dirname -- "$1")" 2>/dev/null && pwd -P) || return 1
    [ "$candidate_dir" = "$script_dir" ]
}

if [ -n "${CLAUDE_YOLO_ORIGINAL:-}" ]; then
    # An explicit override is authoritative: do not second-guess it.
    original=$CLAUDE_YOLO_ORIGINAL
else
    original=
    if [ -r "$script_dir/../original-path" ]; then
        IFS= read -r original < "$script_dir/../original-path" || original=
    fi
    # Self-heal: if the recorded path is stale (Claude moved, was reinstalled
    # elsewhere, or a broken install recorded the shim itself), rediscover it
    # from PATH instead of failing.
    if [ -z "${original:-}" ] || [ ! -x "$original" ] || points_at_self "$original"; then
        original=
        old_ifs=$IFS
        IFS=:
        for directory in ${PATH:-}; do
            [ -n "$directory" ] || directory=.
            resolved_directory=$(CDPATH= cd -- "$directory" 2>/dev/null && pwd -P) || continue
            [ "$resolved_directory" = "$script_dir" ] && continue
            candidate=$resolved_directory/claude
            if [ -f "$candidate" ] && [ -x "$candidate" ]; then
                original=$candidate
                break
            fi
        done
        IFS=$old_ifs
    fi
fi

if [ -z "${original:-}" ] || [ ! -x "$original" ] || points_at_self "$original"; then
    echo "claude-yolo: could not find the original Claude executable" >&2
    exit 127
fi

exec "$original" "$@"
